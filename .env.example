# Development mode: no key, no network; an imaginary approver answers.
DELIVERD_MODE=development
# approved (default) | rejected | denied | timeout | question
# DELIVERD_DEV_OUTCOME=rejected

# Real organisation: remove DELIVERD_MODE above and set your key (dlv_...).
DELIVERD_API_KEY=
# Only for non-hosted deployments.
# DELIVERD_BASE_URL=

# Webhook signing secret (this repo's name; the SDK doesn't define one).
# DELIVERD_WEBHOOK_SECRET=

# Who live demos ask (an email, name or group).
DEMO_APPROVER=
# The approve-callback demo's public HTTPS address: a tunnel such as
# `ngrok http 4567` pointed at PORT (default 4567).
# DEMO_CALLBACK_URL=https://example.ngrok-free.app
# The report the live review demo asks about (printed by the publish demo).
# DEMO_REPORT_ID=
